# Copy to .env and fill in. Never commit .env.
PORT=5000

# Payments — Paystack (test keys start with sk_test_ / pk_test_)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Email (pick one provider; dev default logs to console)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@onlinemarketplace.local
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# SMS / Push (pick one provider; dev default logs to console)
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_SERVER_KEY=

# Shipping (generic courier API; vendor self-delivery is the fallback)
SHIPPING_PROVIDER=manual
SHIPPING_API_URL=
SHIPPING_API_KEY=
